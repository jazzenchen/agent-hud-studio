# This repository is public. Anything personal, heavy or generated stays on this Mac.

# --- Personal material: photos, voice, scans of people -------------------------------
# Everything personal goes in assets/personal/ (photos/, voice/, splats/). The dev server
# serves splats/ at /assets/avatars/; builds never include it (see vite.config.ts).
# The rest of assets/ is the local workbench: raw audio, .blend files, the BlenderKit cache.
# Nothing in assets/ is published; the page only reads public/.
/assets/
# Never put a person's material under public/: it is copied into dist/ and deployed.
/public/assets/avatars/
# Splats and point clouds anywhere, and raw voice or sound recordings.
*.ply
*.spz
*.splat
*.ksplat
*.wav
*.aiff
*.m4a
# A folder for anything else that must never leave this Mac.
/private/
/local/

# --- Generated output ------------------------------------------------------------------
/dist/
/exports/
/renders/
/public/assets/full_loft.glb
# Rust/burn autotune cache written by local tools
/target/

# --- Blender -----------------------------------------------------------------------------
*.blend
*.blend1
*.blend2

# --- Dependencies and tool state --------------------------------------------------------
node_modules/
.vite/
.wrangler/
__pycache__/
*.pyc
.venv/
.claude/settings.local.json

# --- Secrets -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# --- System and editor -------------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
.idea/
